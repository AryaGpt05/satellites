# Overflight environment. Copy to .env.local for development; set the same names in the Vercel project.
#
# Supabase (RPC-only access; see supabase/migrations). Use the PUBLISHABLE key (sb_publishable_…),
# never a secret/service_role key: it ships to every browser. Leave both empty to run without a
# backend: lookups, shares and stats then no-op gracefully.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Optional, server-side only (api/*): canonical origin for absolute og:image / canonical URLs, e.g.
# https://overflight.app. Defaults to the request's own origin.
SITE_URL=
